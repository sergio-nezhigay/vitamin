{% doc %}
  @prompt
    Layout Desktop:
    
    Zweispaltig:
    
    Linke Seite: Text-Content
    
    Ein grosser Titel (Heading)
    
    Ein Untertitel (Subheading)
    
    Drei Bulletpoints, jeweils bestehend aus:
    
    einem Icon (Bild-Upload möglich im Editor)
    
    einem kurzen Beschreibungstext daneben
    
    Rechte Seite: Ein Bild mit Desktop-Grösse von 2000 × 1400 px. es soll auch die möglichkeit geben die grösse des bild anzupassen
    
    Layout Mobile:
    
    Bild oberhalb des Textbereichs
    
    Bildgrösse 1000 × 1000 px
    
    Wenn kein separates Mobile-Bild hochgeladen wird, soll das Desktop-Bild als Default verwendet werden
    
    Design-Anforderungen:
    
    Gleichmässige vertikale Abstände
    
    Saubere, moderne Typografie
    
    Icons und Text der Bulletpoints sollen horizontal ausgerichtet sein
    
    Alle Inhalte (Titel, Untertitel, Icons, Texte, Bilder) müssen im Theme-Editor individuell anpassbar sein
    
    Section soll sich automatisch an den Viewport anpassen (responsive, barrierefrei, retina-optimiert), jeder bulletpoint soll mit einem icon starten und neben dran ein titel stehen den ich jederzeit anpassen kann und danach folgt der text, ich soll die weite der section selbst verstellen können
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    padding: 40px 20px;
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      padding: 60px 40px;
    }
  }

  .ai-two-column-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
    order: 2;
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-content-{{ ai_gen_id }} {
      order: 1;
    }
  }

  .ai-two-column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.2;
    margin: 0;
    color: {{ block.settings.heading_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-two-column-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size_mobile }}px;
    line-height: 1.4;
    margin: 0;
    color: {{ block.settings.subheading_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }
  }

  .ai-two-column-bullets-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.bullet_spacing }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-two-column-bullet-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-two-column-bullet-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 4px;
  }

  .ai-two-column-bullet-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-two-column-bullet-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-column-bullet-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-two-column-bullet-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.bullet_title_text_gap }}px;
  }

  .ai-two-column-bullet-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.bullet_title_size }}px;
    line-height: 1.3;
    font-weight: 600;
    color: {{ block.settings.bullet_title_color }};
    margin: 0;
  }

  .ai-two-column-bullet-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.bullet_text_size }}px;
    line-height: 1.5;
    color: {{ block.settings.bullet_text_color }};
  }

  .ai-two-column-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    order: 1;
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-image-wrapper-{{ ai_gen_id }} {
      order: 2;
    }
  }

  .ai-two-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-image-placeholder-{{ ai_gen_id }} {
      aspect-ratio: 10 / 7;
    }
  }

  .ai-two-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-two-column-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<div class="ai-two-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-two-column-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-two-column-subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    <ul class="ai-two-column-bullets-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign bullet_title_key = 'bullet_' | append: i | append: '_title'
          assign bullet_text_key = 'bullet_' | append: i | append: '_text'
          assign bullet_icon_key = 'bullet_' | append: i | append: '_icon'
          assign bullet_title = block.settings[bullet_title_key]
          assign bullet_text = block.settings[bullet_text_key]
          assign bullet_icon = block.settings[bullet_icon_key]
        %}

        {% if bullet_title != blank or bullet_text != blank %}
          <li class="ai-two-column-bullet-{{ ai_gen_id }}">
            <div class="ai-two-column-bullet-icon-{{ ai_gen_id }}">
              {% if bullet_icon %}
                <img
                  src="{{ bullet_icon | image_url: width: 200 }}"
                  alt="{{ bullet_title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.icon_size }}"
                  height="{{ block.settings.icon_size }}"
                >
              {% else %}
                <div class="ai-two-column-bullet-icon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-two-column-bullet-content-{{ ai_gen_id }}">
              {% if bullet_title != blank %}
                <h3 class="ai-two-column-bullet-title-{{ ai_gen_id }}">
                  {{ bullet_title }}
                </h3>
              {% endif %}
              {% if bullet_text != blank %}
                <div class="ai-two-column-bullet-text-{{ ai_gen_id }}">
                  {{ bullet_text }}
                </div>
              {% endif %}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <div class="ai-two-column-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image_desktop or block.settings.image_mobile %}
      <picture>
        {% if block.settings.image_mobile %}
          <source
            media="(max-width: 749px)"
            srcset="{{ block.settings.image_mobile | image_url: width: 1000 }} 1x, {{ block.settings.image_mobile | image_url: width: 2000 }} 2x"
          >
        {% endif %}
        {% if block.settings.image_desktop %}
          <img
            src="{{ block.settings.image_desktop | image_url: width: 2000 }}"
            srcset="{{ block.settings.image_desktop | image_url: width: 2000 }} 1x, {{ block.settings.image_desktop | image_url: width: 4000 }} 2x"
            alt="{{ block.settings.image_desktop.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_desktop.width }}"
            height="{{ block.settings.image_desktop.height }}"
            class="ai-two-column-image-{{ ai_gen_id }}"
          >
        {% elsif block.settings.image_mobile %}
          <img
            src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
            srcset="{{ block.settings.image_mobile | image_url: width: 1000 }} 1x, {{ block.settings.image_mobile | image_url: width: 2000 }} 2x"
            alt="{{ block.settings.image_mobile.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_mobile.width }}"
            height="{{ block.settings.image_mobile.height }}"
            class="ai-two-column-image-{{ ai_gen_id }}"
          >
        {% endif %}
      </picture>
    {% else %}
      <div class="ai-two-column-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-two-column-empty-state-{{ ai_gen_id }}">
          Bild hinzufügen
        </div>
      </div>
    {% endif %}
  </div>
</div>

