                      src="{{ block.settings.testimonial_5_image | image_url: width: 80 }}"
                      alt="{{ block.settings.testimonial_5_name | escape }}"
                      class="ai-hero-marquee-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="{{ block.settings.marquee_image_size }}"
                      height="{{ block.settings.marquee_image_size }}"
                    >
                  {% else %}
                    <div class="ai-hero-marquee-image-placeholder-{{ ai_gen_id }}"></div>
                  {% endif %}

                  <div class="ai-hero-marquee-content-{{ ai_gen_id }}">
                    {% if block.settings.testimonial_5_show_stars %}
                      <div class="ai-hero-marquee-stars-{{ ai_gen_id }}">
                        {% for star in (1..block.settings.testimonial_5_star_count) %}
                          <svg class="ai-hero-marquee-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        {% endfor %}
                      </div>
                    {% endif %}

                    <p class="ai-hero-marquee-name-{{ ai_gen_id }}">{{ block.settings.testimonial_5_name }}</p>

                    {% if block.settings.testimonial_5_text != blank %}
                      <p class="ai-hero-marquee-text-{{ ai_gen_id }}">{{ block.settings.testimonial_5_text }}</p>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

