{% doc %}
  @prompt
    Erstelle mir eine responsive Section mit 4 Schritten, die horizontal nebeneinander angezeigt werden (auch mobil gut gestapelt).
    Jeder Schritt soll aus einem Bild, einem Titel (z. B. Schritt 1: …) und einem kurzen Beschreibungstext bestehen.
    
    Layout-Anforderungen:
    
    Desktop: 4 gleich breite Spalten nebeneinander
    
    Mobile: Schritte nebeneinander als slide
    
    Bild oben, Titel darunter, Text darunter
    
    Einheitlicher Stil (gleiche Abstände, Typografie und Bildgrössen)
    
    Möglichkeit, Bilder, Titel und Texte im Editor individuell anzupassen
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-steps-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-steps-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-steps-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-steps-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.gap_desktop }}px;
  }

  .ai-step-item-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-step-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.image_spacing }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-step-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-step-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-step-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin-bottom: {{ block.settings.title_spacing }}px;
    font-weight: 600;
  }

  .ai-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-steps-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ block.settings.gap_mobile }}px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 10px;
    }

    .ai-steps-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-step-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_slide_width }}%;
      scroll-snap-align: start;
    }

    .ai-steps-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-step-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.9);
    }

    .ai-step-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-steps-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-steps-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-steps-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    <div class="ai-steps-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'step_' | append: i | append: '_image'
          assign title_key = 'step_' | append: i | append: '_title'
          assign description_key = 'step_' | append: i | append: '_description'
          
          assign step_image = block.settings[image_key]
          assign step_title = block.settings[title_key]
          assign step_description = block.settings[description_key]
        %}

        <div class="ai-step-item-{{ ai_gen_id }}">
          <div class="ai-step-image-wrapper-{{ ai_gen_id }}">
            {% if step_image %}
              <img
                src="{{ step_image | image_url: width: 600 }}"
                alt="{{ step_image.alt | escape }}"
                loading="lazy"
                width="{{ step_image.width }}"
                height="{{ step_image.height }}"
                class="ai-step-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-step-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if step_title != blank %}
            <h3 class="ai-step-title-{{ ai_gen_id }}">{{ step_title }}</h3>
          {% endif %}

          {% if step_description != blank %}
            <div class="ai-step-description-{{ ai_gen_id }}">{{ step_description }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

