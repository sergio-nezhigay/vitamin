{% doc %}
  @prompt
    Layout Desktop:
    
    Zweispaltig:
    
    Linke Seite: Text-Content
    
    Ein grosser Titel (Heading)
    
    Ein Untertitel (Subheading)
    
    Drei Bulletpoints, jeweils bestehend aus:
    
    einem Icon (Bild-Upload möglich im Editor)
    
    einem kurzen Beschreibungstext daneben
    
    Rechte Seite: Ein Bild mit fester Desktop-Grösse von 2000 × 1400 px
    
    Layout Mobile:
    
    Bild oberhalb des Textbereichs
    
    Bildgrösse 1000 × 1000 px
    
    Wenn kein separates Mobile-Bild hochgeladen wird, soll das Desktop-Bild als Default verwendet werden
    
    Design-Anforderungen:
    
    Gleichmässige vertikale Abstände
    
    Saubere, moderne Typografie
    
    Icons und Text der Bulletpoints sollen horizontal ausgerichtet sein
    
    Alle Inhalte (Titel, Untertitel, Icons, Texte, Bilder) müssen im Theme-Editor individuell anpassbar sein
    
    Section soll sich automatisch an den Viewport anpassen (responsive, barrierefrei, retina-optimiert)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    padding: 40px 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      padding: 60px 40px;
    }

    .ai-two-column-content-{{ ai_gen_id }}--reverse {
      direction: rtl;
    }

    .ai-two-column-content-{{ ai_gen_id }}--reverse > * {
      direction: ltr;
    }
  }

  .ai-two-column-content__text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-two-column-content__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.2;
    color: {{ block.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-content__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-two-column-content__subheading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subheading_size_mobile }}px;
    line-height: 1.4;
    color: {{ block.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-content__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }
  }

  .ai-two-column-content__bullets-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.bullet_spacing }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-two-column-content__bullet-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .ai-two-column-content__bullet-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-column-content__bullet-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-two-column-content__bullet-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.text_color }};
    opacity: 0.1;
    border-radius: 4px;
  }

  .ai-two-column-content__bullet-text-{{ ai_gen_id }} {
    flex: 1;
    font-size: {{ block.settings.bullet_text_size_mobile }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    padding-top: 2px;
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-content__bullet-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.bullet_text_size_desktop }}px;
    }
  }

  .ai-two-column-content__image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-column-content__image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-content__image-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-two-column-content__image-{{ ai_gen_id }} img {
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-content__image-{{ ai_gen_id }} img {
      aspect-ratio: 2000 / 1400;
      object-fit: cover;
    }
  }

  .ai-two-column-content__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-content__image-placeholder-{{ ai_gen_id }} {
      aspect-ratio: 1 / 1;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-content__image-placeholder-{{ ai_gen_id }} {
      aspect-ratio: 2000 / 1400;
    }
  }

  .ai-two-column-content__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-two-column-content__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<div
  class="ai-two-column-content-{{ ai_gen_id }} {% if block.settings.image_position == 'left' %}ai-two-column-content-{{ ai_gen_id }}--reverse{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="ai-two-column-content__text-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-two-column-content__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-two-column-content__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </p>
    {% endif %}

    <ul class="ai-two-column-content__bullets-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign bullet_icon_key = 'bullet_' | append: i | append: '_icon'
          assign bullet_text_key = 'bullet_' | append: i | append: '_text'
          assign bullet_icon = block.settings[bullet_icon_key]
          assign bullet_text = block.settings[bullet_text_key]
        %}

        {% if bullet_text != blank %}
          <li class="ai-two-column-content__bullet-{{ ai_gen_id }}">
            <div class="ai-two-column-content__bullet-icon-{{ ai_gen_id }}">
              {% if bullet_icon %}
                <img
                  src="{{ bullet_icon | image_url: width: 200 }}"
                  alt="{{ bullet_text | escape }}"
                  loading="lazy"
                  width="{{ block.settings.icon_size }}"
                  height="{{ block.settings.icon_size }}"
                >
              {% else %}
                <div class="ai-two-column-content__bullet-icon-placeholder-{{ ai_gen_id }}"></div>
              {% endif %}
            </div>
            <div class="ai-two-column-content__bullet-text-{{ ai_gen_id }}">
              {{ bullet_text }}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <div class="ai-two-column-content__image-{{ ai_gen_id }}">
    {% if block.settings.image_desktop %}
      <picture>
        {% if block.settings.image_mobile %}
          <source
            media="(max-width: 749px)"
            srcset="{{ block.settings.image_mobile | image_url: width: 1000 }} 1x, {{ block.settings.image_mobile | image_url: width: 2000 }} 2x"
          >
        {% endif %}
        <source
          media="(min-width: 750px)"
          srcset="{{ block.settings.image_desktop | image_url: width: 2000 }} 1x, {{ block.settings.image_desktop | image_url: width: 4000 }} 2x"
        >
        <img
          src="{{ block.settings.image_desktop | image_url: width: 2000 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="2000"
          height="1400"
        >
      </picture>
    {% else %}
      <div class="ai-two-column-content__image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-two-column-content__empty-state-{{ ai_gen_id }}">
          Bild hinzufügen
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Zweispaltige Sektion",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bildposition",
      "options": [
        {
          "value": "right",
          "label": "Rechts"
        },
        {
          "value": "left",
          "label": "Links"
        }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Überschrift"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Unsere Vorteile"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Titelgrösse (Mobil)",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Titelgrösse (Desktop)",
      "default": 42
    },
    {
      "type": "header",
      "content": "Untertitel"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Untertitel",
      "default": "Entdecken Sie, was uns besonders macht"
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Untertitelgrösse (Mobil)",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Untertitelgrösse (Desktop)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Bulletpoint 1"
    },
    {
      "type": "image_picker",
      "id": "bullet_1_icon",
      "label": "Icon"
    },
    {
      "type": "textarea",
      "id": "bullet_1_text",
      "label": "Text",
      "default": "Hochwertige Qualität für langlebige Produkte"
    },
    {
      "type": "header",
      "content": "Bulletpoint 2"
    },
    {
      "type": "image_picker",
      "id": "bullet_2_icon",
      "label": "Icon"
    },
    {
      "type": "textarea",
      "id": "bullet_2_text",
      "label": "Text",
      "default": "Schnelle Lieferung innerhalb von 2-3 Werktagen"
    },
    {
      "type": "header",
      "content": "Bulletpoint 3"
    },
    {
      "type": "image_picker",
      "id": "bullet_3_icon",
      "label": "Icon"
    },
    {
      "type": "textarea",
      "id": "bullet_3_text",
      "label": "Text",
      "default": "30 Tage Rückgaberecht ohne Risiko"
    },
    {
      "type": "header",
      "content": "Bulletpoint-Stil"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Icongrösse",
      "default": 48
    },
    {
      "type": "range",
      "id": "bullet_text_size_mobile",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Textgrösse (Mobil)",
      "default": 15
    },
    {
      "type": "range",
      "id": "bullet_text_size_desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Textgrösse (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "bullet_spacing",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Abstand zwischen Bulletpoints",
      "default": 20
    },
    {
      "type": "header",
      "content": "Bilder"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop-Bild (2000 × 1400 px)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobil-Bild (1000 × 1000 px)"
    },
    {
      "type": "paragraph",
      "content": "Wenn kein Mobil-Bild hochgeladen wird, wird das Desktop-Bild verwendet"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Bildabrundung",
      "default": 8
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#043841"
    }
  ],
  "presets": [
    {
      "name": "Zweispaltige Sektion"
    }
  ]
}
{% endschema %}