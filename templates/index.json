        "question_34cFHt": {
          "type": "question",
          "settings": {
            "question": "Ist VitaminH2 für Vegetarier und Veganer geeignet?",
            "answer": "<p>Ja, VitaminH2 ist zu 100% vegan und enthält keine tierischen Inhaltsstoffe.</p>"
