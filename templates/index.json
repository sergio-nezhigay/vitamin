    "image_with_text_xEVRHw": {
      "type": "image-with-text",
      "blocks": {
        "heading_DCz3YM": {
          "type": "heading",
          "settings": {
            "text": "",
            "text2": "<h2>Wissenschaftlich belegter Zellschutz und Energie von innen</h2>",
            "heading_tag": "h3"
          }
        },
        "richtext_h8GXmh": {
          "type": "richtext",
          "settings": {
            "content_class": "first-content",
            "content2": "",
            "content": "<p>VitaminH2 nutzt die Kraft von molekularem Wasserstoff, um deine Zellen von innen zu schützen, oxidativen Stress zu reduzieren und deine natürliche Energieproduktion zu aktivieren.</p>"
          }
        },
        "richtext_7q78Ud": {
          "type": "richtext",
          "settings": {
            "content_class": "benefits-content one",
            "content2": "<p>Die Wissenschaft hinter der Wirkung</p>",
            "content": "<p>Molekularer Wasserstoff ist das kleinste und effektivste Antioxidans der Welt. Er gelangt direkt in die Zellen, wo oxidativer Stress entsteht, und schützt sie dort gezielt vor Schäden. Seine Wirkung ist in über 1.000 wissenschaftlichen Studien dokumentiert.</p>"
          }
        },
        "richtext_NPdWkx": {
          "type": "richtext",
          "settings": {
            "content_class": "benefits-content two",
            "content2": "<p>Spürbare Regeneration und Energie</p>",
            "content": "<p>Durch die innovative HydraFusion® Technologie wird der Wasserstoff optimal freigesetzt. Das unterstützt deine Mitochondrien bei der Energieproduktion und beschleunigt die Regeneration nach körperlicher oder mentaler Belastung.</p>"
          }
        },
        "richtext_VHXhhb": {
          "type": "richtext",
          "settings": {
            "content_class": "benefits-content three",
            "content2": "<p><strong>100% Natürliche Inhaltsstoffe</strong></p>",
            "content": "<p>Frei von Zucker, Farbstoffen, Gluten, Soja und Laktose. Eine reine, hochwirksame Ergänzung, die du bedenkenlos täglich einnehmen kannst.</p>"
          }
        }
      },
      "block_order": [
